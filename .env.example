# Optional server settings
PORT=3001
DATABASE_PATH=./data/incidents.db

# Authentication mode: github-app or user-token
COPILOT_AUTH_MODE=github-app

# Required when COPILOT_AUTH_MODE=github-app
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPOSITORY_ID=

# Required when COPILOT_AUTH_MODE=user-token
# Use a github_pat_ fine-grained PAT with Copilot Requests permission,
# or a supported gho_/ghu_ OAuth user token. Classic ghp_ tokens are unsupported.
COPILOT_USER_TOKEN=

COPILOT_MODEL=gpt-5
