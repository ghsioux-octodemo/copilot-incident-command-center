# Optional server settings
PORT=3001
DATABASE_PATH=./data/incidents.db

# Required for live GitHub Copilot SDK access
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=

# Paste the complete PEM value between quotes. Both key headers are supported:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# ...all lines from the downloaded .pem file...
# -----END RSA PRIVATE KEY-----"
#
# A single line with escaped newlines also works:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GITHUB_APP_PRIVATE_KEY=

# Find this value with:
# gh api repos/OWNER/REPOSITORY --jq .id
GITHUB_REPOSITORY_ID=

# The model must be enabled by the organization's Copilot policy.
COPILOT_MODEL=gpt-6-sol
